---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoSlot from '../../components/PhotoSlot.astro';

// EP:n kielentarkastus 28.7.2026: esittelyt ovat nyt EP:n omaa kieltä.
// Huomioita, jotka kannattaa säilyttää: ei "toimia jonakin" -rakennetta, kun
// suora verbi käy ("häntä valmentaa", ei "valmentajana toimii"); T54-luokassa
// eikä "luokassa T54"; 100 metrin, ei 100m.
//
// Session 4. Suomennos oli Claude-luonnos EP:n rekisterissä — EP tekee
// kielitarkistuksen ennen julkaisua, kuten Sessiossa 3.
//
// Kaksi asiaa on tarkoituksellista ja niiden pitäisi säilyä muokkauksissa:
//
// 1. Paralympiarivit kertovat kierroksen. Kaikki kolme ovat alkueräsijoituksia
//    eikä EP edennyt finaaliin yhdessäkään; pelkkä "6." samassa sarakkeessa
//    Koben 2024 viidennen sijan kanssa lukisi vastaavana tuloksena.
// 2. Sivulla ei ole tulevaisuuden aikajännettä. Jos ura päättyy kauteen 2026,
//    suunnitelman carry-overit listaavat kolme tiedostoa jotka muuttuvat
//    yhdessä — tämä sivu ei ole neljäs.
//
// Kuvat: vain portrait.jpg. Ks. suunnitelman liite G.

const facts = [
  { k: 'Syntynyt', v: '7.3.1989' },
  { k: 'Luokka', v: 'T54' },
  { k: 'Päämatka', v: '100 m' },
  // Lähde lisätty 28.7.2026: kilpailun oma tulospalvelu merkitsee rivin PB, ja
  // IPC:n vuoden 2024 maailmanlista vahvistaa saman (14,08, tuuli +0,7, sija 6=).
  { k: 'Ennätys', v: '14,08', href: 'https://live.time4results.com/yu/2024/motonetgp/kuortane/22-1-r.html' },
  { k: 'Seura', v: 'Espoon Tapiot', href: 'https://espoontapiot.fi/' },
  { k: 'Valmentaja', v: 'Leo-Pekka Tähti', href: 'https://leopekkatahti.fi/' },
  { k: 'Kotipaikka', v: 'Espoo' },
  // Sama muoto kuin englanninkielisellä sivulla: yksi erotin, ja jokainen
  // ilmoitettu taso samassa sulkumuodossa.
  { k: 'Kielet', v: 'suomi · englanti · saksa (B1) · ruotsi (alkeet)' },
];

// Aika omassa sarakkeessaan, jotta kehitys luetaan sarakkeena alaspäin.
// Jokaisella rivillä on aika, myös kolmella alkuerällä — aika on niissä
// kisoissa rehellisin mittari, kun sijoitus vaatii tarkennuksen.
//
// Taulukossa ovat vain arvokisat: paralympialaiset, MM- ja EM-kisat. Yllä
// olevan faktalaatikon ennätys 14,08 on Motonet GP:stä, joten se ei kuulu
// tänne. Kuvateksti kertoo rajauksen sen sijaan, että väittäisi "kaikki
// tulokset" — muuten lähteistetty ennätyslinkki näyttäisi puuttuvalta riviltä.
//
// Neljät MM-kisat, joissa EP ei edennyt finaaliin — 2011 Christchurch, 2013
// Lyon, 2015 Doha, 2017 Lontoo — ovat nyt mukana. Ne odottivat, kunnes EP
// toimitti ajat 3.8.2026: IPC:n tietokanta antaa sijoitukset muttei aikoja, ja
// jokaisella tämän taulukon rivillä on aika.
//
// Tulossarakkeessa on KOLME eri perustetta, minkä vuoksi taulukon alla oleva
// huomautus avaa ne. Finaaleissa lopullinen sijoitus. Paralympiariveillä
// sijoitus OMASSA alkuerässä. Välieräriveillä KOKONAISsijoitus kyseisissä
// kisoissa — ei sijoitus omassa erässä. Näitä ei pidä "siistiä" yhteen muotoon:
// 9. kokonaissijoitus ja 9. omassa erässä ovat eri väitteitä, ja IPC nimeää
// kierrokset epäjohdonmukaisesti ("Semifinal 2: 9th" Lyon, "Heat 1: 9th"
// Lontoo). Välierässä ei ole yhdeksättä maaliintulijaa — siitä tiedämme, että
// nuo yhdeksiköt olivat aina kokonaissijoituksia.
//
// Vuodelta 2018 EI puutu riviä: EP oli tauolla loppuvuodesta 2017 vuoteen 2019.
// Kirjattu tähän, ettei tulevassa tarkistuksessa lähdetä etsimään sellaista.
//
// Kuvateksti ei vieläkään sano "kaikki". Vuodesta 2011 eteenpäin taulukko on
// kattava, mutta EP on kilpaillut vuodesta 2005 eikä ole varmistettu, puuttuuko
// ennen Christchurchia 2011 jokin arvokisa. Yksi kyllä EP:ltä, ja kuvatekstiin
// palaa "Kaikki".
const results = [
  { year: '2025', event: 'MM-kisat, New Delhi', result: '7.', time: '14,15' },
  { year: '2024', event: 'MM-kisat, Kobe', result: '5.', time: '14,33' },
  { year: '2023', event: 'MM-kisat, Pariisi', result: '8.', time: '14,57' },
  { year: '2021', event: 'EM-kisat, Bydgoszcz', result: 'Pronssi', time: '14,39', medal: true },
  { year: '2020', event: 'Paralympialaiset, Tokio', result: 'Alkuerä, 6.', time: '14,71' },
  { year: '2017', event: 'MM-kisat, Lontoo', result: 'Välierä, kokonaissijoitus 9.', time: '15,09' },
  { year: '2016', event: 'Paralympialaiset, Rio', result: 'Alkuerä, 5.', time: '15,07' },
  // EM-rivit ovat kaikki FINAALIsijoituksia, eivät alkueriä. Lähteinä itse
  // kisat: Grosseto IPC:n virallisesta tulospalvelusta (kahdeksan miehen
  // finaali, EP 8. ajalla 16,30), Swansea täydestä kuuden miehen finaalista
  // (EP 5. ajalla 15,43). Stadskanaal (4., 15,21) on EP:n oma tieto ja vastaa
  // riippumatonta lähdettä. EP vahvisti kaikki kolme 3.8.2026.
  { year: '2016', event: 'EM-kisat, Grosseto', result: '8.', time: '16,30' },
  { year: '2015', event: 'MM-kisat, Doha', result: 'Välierä, kokonaissijoitus 11.', time: '14,87' },
  { year: '2014', event: 'EM-kisat, Swansea', result: '5.', time: '15,43' },
  { year: '2013', event: 'MM-kisat, Lyon', result: 'Välierä, kokonaissijoitus 9.', time: '14,71' },
  { year: '2012', event: 'Paralympialaiset, Lontoo', result: 'Alkuerä, 6.', time: '14,99' },
  { year: '2012', event: 'EM-kisat, Stadskanaal', result: '4.', time: '15,21' },
  { year: '2011', event: 'MM-kisat, Christchurch', result: 'Välierä, kokonaissijoitus 15.', time: '15,53' },
];
---

<BaseLayout
  title="Media"
  lang="fi"
  description="Median aineistot Esa-Pekka Mattilasta, T54-luokan pyörätuolikelaajasta: esittelytekstit, perustiedot, tulokset ja ladattava muotokuva."
>
  <section class="press-hero">
    <div class="wrap">
      <p class="kicker">Media</p>
      <h1>Esittely, faktat,<br />tulokset<span class="accent-text">.</span></h1>
      <p class="lead">
        Kaikki tällä sivulla on vapaasti käytettävissä ja lainattavissa. Jos
        tarvitset jotain, mitä täältä ei löydy, kirjoita osoitteeseen <a href="mailto:press@esapekkamattila.com">press@esapekkamattila.com</a>.
      </p>
    </div>
  </section>

  <section class="narrative" id="bio">
    <div class="wrap">
      <div class="sec-head reveal"><span class="idx mono">01</span><h2>Esittely</h2></div>
      <div class="bios reveal">
        <div class="bio-block">
          <p class="bio-label mono">Lyhyt · ~50 sanaa</p>
          <p>
            Esa-Pekka Mattila (s. 7.3.1989) on suomalainen 100 metrin
            pyörätuolikelaaja T54-luokassa. Hän on kolminkertainen
            paralympiaurheilija (Lontoo 2012, Rio 2016, Tokio 2020) sekä vuoden
            2021 EM-pronssimitalisti. Hänen ennätyksensä 100 metrillä on 14,08.
            Mattila on kuulunut maailman kärkikahdeksikkoon vuodesta 2023 ja
            kilpaillut kolmessa peräkkäisessä MM-finaalissa. Hän on Suomen
            Olympiakomitean urheilijavaliokunnan puheenjohtaja.
          </p>
        </div>
        <div class="bio-block">
          <p class="bio-label mono">Pitkä · ~110 sanaa</p>
          <p>
            Esa-Pekka Mattila (s. 7.3.1989) on suomalainen 100 metrin
            pyörätuolikelaaja T54-luokassa. Hän on kilpaillut kansainvälisesti
            vuodesta 2005. Mattila on kolminkertainen paralympiaurheilija
            (Lontoo 2012, Rio 2016, Tokio 2020) ja voitti EM-pronssia 100
            metrillä Bydgoszczissa vuonna 2021. Hän on kuulunut maailman
            kärkikahdeksikkoon vuodesta 2023: kahdeksas MM-kisoissa Pariisissa
            2023 (14,57), viides Kobessa 2024 (14,33) ja seitsemäs New
            Delhissä 2025 (14,15). Mattilan ennätys 100 metrillä on 14,08. Hän
            edustaa Espoon Tapioita, ja häntä valmentaa Leo-Pekka Tähti.
          </p>
          <p>
            Radan ulkopuolella Mattila on Suomen Olympiakomitean
            urheilijavaliokunnan puheenjohtaja ja Olympiakomitean hallituksen
            jäsen. Lisäksi hän kuuluu Suomen Urheiluliiton ja Suomen Urheilijat
            ry:n hallituksiin sekä on Abilis-säätiön varapuheenjohtaja. Hän
            viimeistelee maisterintutkintoa yritysjuridiikasta Aalto-yliopiston
            kauppakorkeakoulussa ja konsultoi pyörätuoli- ja
            apuvälineteknologian parissa. Mattila asuu Espoossa.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="narrative" id="facts">
    <div class="wrap">
      <div class="sec-head reveal"><span class="idx mono">02</span><h2>Perustiedot</h2></div>
      <dl class="factsheet reveal">
        {facts.map((f) => (
          <div class="fact-row">
            <dt class="mono">{f.k}</dt>
            <dd>{f.href ? <a href={f.href} target="_blank" rel="noopener">{f.v}</a> : f.v}</dd>
          </div>
        ))}
      </dl>
      <div class="prose reveal classnote">
        <p>
          <strong>Mitä luokka T54 tarkoittaa:</strong> T54 (Track 54) on
          parayleisurheilun luokka pyörätuolikelaajille, joilla on täysi käsien
          lihasvoima ja osittainen tai täysi vartalon lihasvoima; osalla
          urheilijoista on lisäksi jonkin verran toimintakykyä jaloissa.
          Kelaustuolia liikutetaan lyömällä kelausvanteita käsin ja kelaajilla
          on joko pehmeät kelaushanskat tai kovat kelauskapulat. 100 metrillä
          laji on puhdas pikamatka ja kelaajan vauhti kiihtyy aina maaliin asti.
          T54 on lukumääräisesti suurin vammaluokka. 1500 metrin ja pidemmät
          matkat kelataan yhdessä luokan T53 kanssa. Luokitusmääritelmistä
          vastaa <a
            href="https://www.paralympic.org/news/sport-week-classification-para-athletics"
            target="_blank"
            rel="noopener">World Para Athletics</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="narrative" id="results">
    <div class="wrap">
      <div class="sec-head reveal"><span class="idx mono">03</span><h2>Tulokset</h2></div>
      <div class="table-scroll reveal">
        <table class="results">
          <caption>Arvokisatulokset 100 m, luokka T54.</caption>
          <thead>
            <tr>
              <th scope="col">Vuosi</th>
              <th scope="col">Kilpailu</th>
              <th scope="col">Tulos</th>
              <th scope="col">Aika</th>
            </tr>
          </thead>
          <tbody>
            {results.map((r) => (
              <tr>
                <td class="mono yr">{r.year}</td>
                <td>{r.event}</td>
                <td class={`mono res ${r.medal ? 'accent-text' : ''}`}>{r.result}</td>
                <td class="mono time">{r.time}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="prose reveal classnote">
        <p>
          Rivit ilman finaalia kertovat, kuinka pitkälle pääsin. Kolmella
          paralympiarivillä on sijoitus omassa alkuerässä, neljällä
          välierärivillä kokonaissijoitus kyseisissä kisoissa. Vuosina 2013 ja
          2017 finaaliin pääsi kahdeksan ja olin yhdeksäs. Muut ovat
          finaalisijoituksia.
        </p>
      </div>
    </div>
  </section>

  <section class="narrative" id="images">
    <div class="wrap">
      <div class="sec-head reveal"><span class="idx mono">04</span><h2>Kuva</h2></div>
      <div class="image-grid">
        <div class="image-item reveal">
          <PhotoSlot src="/images/portrait.jpg" alt="Esa-Pekka Mattila" aspect="4/5" />
          <p class="bio-label mono">esa-pekka-mattila-01-portrait.jpg</p>
        </div>
        <div class="prose reveal">
          <p>
            Vapaasti käytettävissä toimituksellisessa yhteydessä. Muu käyttö:
            <a href="mailto:press@esapekkamattila.com">press@esapekkamattila.com</a>.
          </p>
          <p>
            <a href="/images/portrait.jpg" download="esa-pekka-mattila-01-portrait.jpg">Lataa muotokuva</a>.
          </p>
          <p>
            Muut tämän sivuston valokuvat eivät ole minun lisensoitavissani. Jos
            tarvitset kuvaa radalta, ota yhteyttä, niin kysyn valokuvaajalta.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="press-cta">
    <div class="wrap">
      <div class="rule-accent"></div>
      <p class="cta-line">Mediayhteydenotot</p>
      <a href="mailto:press@esapekkamattila.com" class="cta-mail">press@esapekkamattila.com</a>
    </div>
  </section>
</BaseLayout>

<style>
  .press-hero {
    padding-top: clamp(140px, 20vh, 200px);
    padding-bottom: var(--space-5);
  }
  .press-hero h1 {
    margin-top: var(--space-2);
  }
  .accent-text {
    color: var(--accent);
  }
  .narrative {
    border-top: 1px solid var(--rule);
  }
  .sec-head {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: var(--space-3);
  }
  .sec-head .idx {
    color: var(--accent);
    font-size: 0.75rem;
  }
  .prose p {
    font-size: clamp(1.0625rem, 1.5vw, 1.1875rem);
    margin-bottom: var(--space-2);
    max-width: 44rem;
  }

  /* Esittelytekstit omissa lohkoissaan, jotta toimittaja näkee mistä
     lainattava teksti alkaa ja mihin se loppuu. */
  .bios {
    display: grid;
    gap: var(--space-3);
    max-width: 44rem;
  }
  .bio-block {
    border-left: 2px solid var(--accent);
    padding-left: var(--space-2);
  }
  .bio-block p {
    font-size: clamp(1.0625rem, 1.5vw, 1.1875rem);
    margin-bottom: var(--space-2);
  }
  .bio-block p:last-child {
    margin-bottom: 0;
  }
  .bio-label {
    font-size: 0.6875rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: var(--space-1) !important;
  }

  .factsheet {
    max-width: 34rem;
    border-top: 1px solid var(--rule);
  }
  .fact-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
  }
  .fact-row dt {
    font-size: 0.6875rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .fact-row dd {
    text-align: right;
  }
  .classnote {
    margin-top: var(--space-3);
  }

  .table-scroll {
    overflow-x: auto;
  }
  .results {
    width: 100%;
    min-width: 30rem;
    border-collapse: collapse;
    text-align: left;
  }
  .results th {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 400;
    padding: 0 var(--space-2) 12px 0;
    border-bottom: 1px solid var(--rule);
  }
  .results td {
    padding: 14px var(--space-2) 14px 0;
    border-bottom: 1px solid var(--rule);
    vertical-align: baseline;
  }
  .results .yr,
  .results .res,
  .results .time {
    font-size: 0.875rem;
    white-space: nowrap;
  }
  /* Ajat oikeaan reunaan, jotta sarake luetaan yhtenä sarjana. */
  .results th:last-child,
  .results .time {
    text-align: right;
    padding-right: 0;
  }
  /* Jokainen rivi on samaa matkaa ja luokkaa, joten se kerrotaan kerran
     tässä eikä toisteta seitsemää kertaa kilpailusarakkeessa. */
  .results caption {
    text-align: left;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
    padding-bottom: var(--space-2);
  }

  .image-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(32px, 6vw, 84px);
    align-items: start;
  }
  .image-item .bio-label {
    margin-top: var(--space-1);
  }

  .press-cta {
    border-top: 1px solid var(--rule);
  }
  .cta-line {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: var(--space-3);
  }
  .cta-mail {
    display: inline-block;
    margin-top: var(--space-1);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.25rem, 3.5vw, 2.25rem);
    letter-spacing: -0.02em;
  }

  @media (max-width: 860px) {
    .image-grid { grid-template-columns: 1fr; }
  }
</style>
